# Үлгі файл. Көшіріп алыңыз: cp .env.example .env  және нақты мәндерді енгізіңіз.
# Нақты .env файлы .gitignore арқылы репозиторийден шығарылған.

# Қолданба
PORT=3000
APP_ENV=development

# Деректер қоры (PostgreSQL connection string)
# Формат: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://library_user:CHANGE_ME@localhost:5432/library

# Бұлттық DB (Neon, Render т.б.) үшін SSL қосу: true / false
DB_SSL=false

# Docker Compose ішіндегі PostgreSQL контейнері үшін
POSTGRES_USER=library_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=library
